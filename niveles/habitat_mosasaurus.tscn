layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "• [W, A, S, D]: Mover cámara (Adelante, Izquierda, Atrás, Derecha)
• [Espacio / Shift]: Elevar / Descender cámara
• [Clic Derecho + Mover]: Rotar vista libremente en 360°
• [Rueda Ratón]: Velocidad de vuelo de cámara
• [Clic Izquierdo]: Lanzar presa / alimento a la laguna
• [1 / 2 / 3]: Vistas rápidas (1: Panorámica | 2: Ventanal Acuario | 3: Pasarela)
• [H]: Ocultar / Mostrar HUD | [R]: Reubicar Mosasaurio
• [F1 / F2]: Cambiar de Hábitat (F1: Mosasaurio | F2: Triceratops)
• [ESC]: Volver al Menú Principal"

