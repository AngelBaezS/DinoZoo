[node name="Controls" type="Label" parent="UI/Panel/VBox" unique_id=887071079]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "• [W, A, S, D]: Mover cámara sandbox (Adelante, Izquierda, Atrás, Derecha)
• [Espacio / Shift]: Elevar / Descender cámara
• [Clic Derecho + Mover]: Rotar vista libremente en 360°
• [Rueda Ratón]: Ajustar velocidad de vuelo
• [Clic Izquierdo]: Lanzar alimento / vegetación al recinto
• [1 / 2 / 3]: Vistas rápidas (1: Panorámica | 2: Mirador | 3: Estanque de Agua)
• [H]: Ocultar / Mostrar HUD | [R]: Reubicar dinosaurios
• [F1 / F2]: Cambiar Hábitat (F1: Mosasaurio | F2: Triceratops)
• [ESC]: Volver al Menú Principal"
